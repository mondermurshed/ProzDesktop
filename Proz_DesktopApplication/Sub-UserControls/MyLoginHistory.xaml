<base:BaseUserControlMain x:Class="Proz_DesktopApplication.Sub_UserControls.MyLoginHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
               xmlns:base="clr-namespace:Proz_DesktopApplication"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Proz_DesktopApplication.Sub_UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        </Style>
    </UserControl.Resources>
    <Grid>
      
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="MyLoginHistoryDatagrid"
Grid.Row="0"
AutoGenerateColumns="False"
IsReadOnly="True"
AlternationCount="1000000"
SelectionMode="Single"
SelectionUnit="FullRow"
FocusVisualStyle="{x:Null}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="#" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}, Path=AlternationIndex}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Date/Time Logged" Binding="{Binding LoggedOnLocal}" Width="*" />
                    <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceTokenHashed}" Width="*" />
                    <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,20,0">
                <Button Grid.Row="1" Margin="0,10,0,10" Style="{StaticResource MyButtonStyle}" Content="Find A Record With Different device token address" Click="Button_Click"/>

            </StackPanel>
        </Grid>
        
    </Grid>
</base:BaseUserControlMain>
