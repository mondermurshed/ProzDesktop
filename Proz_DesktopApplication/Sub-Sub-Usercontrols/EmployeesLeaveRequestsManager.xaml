<base:BaseUserControlMain x:Class="Proz_DesktopApplication.Sub_Sub_Usercontrols.EmployeesLeaveRequestsManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:base="clr-namespace:Proz_DesktopApplication"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
               xmlns:sub_subUsercontrols ="clr-namespace:Proz_DesktopApplication.Sub_Sub_Sub_Usercontrols"
             xmlns:local="clr-namespace:Proz_DesktopApplication.Sub_Sub_Usercontrols"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Margin="20,30,20,10">
        <mah:MetroAnimatedTabControl mah:HeaderedControlHelper.HeaderFontFamily="Microsoft YaHei UI" mah:TabControlHelper.Underlined="SelectedTabItem" mah:TabControlHelper.UnderlinePlacement="Left">
            <!-- TAB 1 -->
            <TabItem Header="Manage My Employees Leave Requests">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Filter bar -->
                        <RowDefinition Height="250"/>
                        <!-- DataGrid -->
                        <RowDefinition Height="*"/>
                        <!-- Message and buttons -->
                    </Grid.RowDefinitions>

                    <!-- Filter -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Sub-Department:" Style="{StaticResource MyTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="SubDepartmentComboBox" Width="200" Margin="0,0,10,0"/>
                        <Button Content="Get" Style="{StaticResource MyButtonStyle}" Width="80" Click="GetButton_Click"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid x:Name="EmployeeLeaveRequestsDataGrid"
               Grid.Row="1"
               AutoGenerateColumns="False"
               AlternationCount="1000000"
               IsReadOnly="True"
               SelectionMode="Single"
               SelectionChanged="EmployeeLeaveRequestsDataGrid_SelectionChanged"
               FocusVisualStyle="{x:Null}">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="#" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}, Path=AlternationIndex}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Employee Name" Binding="{Binding employeeName}" />
                            <DataGridTextColumn Header="Start" Binding="{Binding From}" />
                            <DataGridTextColumn Header="End" Binding="{Binding To}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Message & Buttons -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,10,10">
                            <TextBlock Text="Reason Message:" Style="{StaticResource MyTextBlockStyle}" Margin="0,0,0,5"/>
                            <TextBox x:Name="EmployeeReasonTextbox" Style="{StaticResource MyTextBoxStyle}" IsReadOnly="True" FontWeight="Medium" FontSize="13" Margin="0,0,0,20"/>
                            <TextBlock Text="Manager Message:" Style="{StaticResource MyTextBlockStyle}" Margin="0,0,0,5"/>
                            <TextBox x:Name="ManagerMessageTextbox" 
                      Style="{StaticResource MyTextBoxStyle}" 
                      
                      TextWrapping="Wrap" 
                      AcceptsReturn="True" 
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Approve" Style="{StaticResource MyButtonStyle}" Width="120" Click="ApproveButton_Click"/>
                                <Button Content="Reject" Style="{StaticResource MyButtonStyle}" Width="120" Margin="10,0,0,0" Click="RejectButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 2 -->
            <TabItem Header="Completed Leave Requests">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="250"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Row -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="20,10,20,10">
                        <TextBlock Text="Sub-Department:" Style="{StaticResource MyTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="SubDepartmentComboBoxtab2" Width="200" Margin="0,0,10,0"/>
                        <Button Content="Get" Style="{StaticResource MyButtonStyle}" Width="80" Click="GetCompletedLeaveRequestsButton_Click"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid x:Name="CompletedRequestsDataGrid"
               Grid.Row="1"
               Margin="20,0,20,10"
               AutoGenerateColumns="False"
               IsReadOnly="True"
               AlternationCount="1000000"
               SelectionMode="Single"
               SelectionChanged="CompletedRequestsDataGrid_SelectionChanged"
               FocusVisualStyle="{x:Null}">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="#" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}, Path=AlternationIndex}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Employee Name" Binding="{Binding employeeName}" />
                            <DataGridTextColumn Header="Start" Binding="{Binding From}" />
                            <DataGridTextColumn Header="End" Binding="{Binding To}" />
                            <DataGridTextColumn Header="Request Started At" Binding="{Binding LeaveRequestOLDAtLocal}" />
                            <DataGridTextColumn Header="Request Answered At" Binding="{Binding AnswerOldInLocal}" />
                            <DataGridTextColumn Header="Request Status" Binding="{Binding Result}" />
                    
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Details Section -->
                    <Grid Grid.Row="2" Margin="20,0,20,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,10,10,10">

                                <TextBlock Text="Employee's Message" Style="{StaticResource MyTextBlockStyle}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="EmployeeMessageTextboxCompleted" 
                          Style="{StaticResource MyTextBoxStyle}" 
                          IsReadOnly="True" 
                          FontSize="13" 
                          Margin="0,0,0,20"/>

                                <TextBlock Text="My Message" Style="{StaticResource MyTextBlockStyle}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="ManagerMessageTextboxCompleted" 
                          Style="{StaticResource MyTextBoxStyle}" 
                          IsReadOnly="True" 
                          FontSize="13" 
                          Margin="0,0,0,20"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>



        </mah:MetroAnimatedTabControl>
    </Border>
</base:BaseUserControlMain>
