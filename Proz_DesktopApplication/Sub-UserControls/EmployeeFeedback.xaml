<base:BaseUserControlMain x:Class="Proz_DesktopApplication.Sub_UserControls.EmployeeFeedback"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 xmlns:sub_subUsercontrols ="clr-namespace:Proz_DesktopApplication.Sub_Sub_Usercontrols"
               xmlns:base="clr-namespace:Proz_DesktopApplication"
               xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Proz_DesktopApplication.Sub_UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Margin="20,30,20,20">
        <mah:MetroAnimatedTabControl mah:HeaderedControlHelper.HeaderFontFamily="Microsoft YaHei UI" mah:TabControlHelper.Underlined="SelectedTabItem" mah:TabControlHelper.UnderlinePlacement="Left">
            <!-- TAB 1 -->
            <TabItem Header="Add A New Feedback">
                <Grid Margin="5,40,5,5">

                    <ScrollViewer  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="30">
                        <StackPanel>





                            <TextBlock  Style="{StaticResource MyTextBlockStyle}" Text="Title" FontWeight="ExtraBold" />
                            <TextBox x:Name="titletextbox" Style="{StaticResource MyTextBoxStyle}" Margin="0,0,0,20" MaxLength="80" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource MyTextBlockStyle}" Text="Feedback type" FontWeight="ExtraBold"/>
                            <ComboBox x:Name="feedbackTypecombobox" Margin="0,0,0,50"/>
                            <TextBlock Style="{StaticResource MyTextBlockStyle}" Text="Description" FontWeight="ExtraBold"  Margin="0,0,0,5"/>
                            <TextBox x:Name="Descriptiontextbox" Style="{StaticResource MyTextBoxStyle}"
 AcceptsReturn="True"
 TextWrapping="Wrap"
 MaxLength="1500"
 VerticalContentAlignment="Top"
 HorizontalContentAlignment="Left"
 VerticalAlignment="Top"
 HorizontalAlignment="Stretch"
 Margin="0,0,0,70"/>
                            <Button Style="{StaticResource MyButtonStyle}" HorizontalAlignment="Stretch" Content="Send Feedback!" Click="CreateANewFeedbackRequestEventHandler" />

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 2 -->
            <TabItem Header="Manage My Feedbacks">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="250"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,5,0,0" Grid.Row="0">
                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="25"/>
                            </Grid.ColumnDefinitions>
                            <DataGrid x:Name="FeedbacksDatagrid" Margin="20,40,20,20" AlternationCount="1000000" SelectionUnit="FullRow" FocusVisualStyle="{x:Null}" SelectionChanged="FeedbacksDatagrid_SelectionChanged"
       AutoGenerateColumns="False"
              IsReadOnly="True"
           
              SelectionMode="Single"
            >

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="#" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}, Path=AlternationIndex}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Feedback Type" Binding="{Binding FeedbackType}" />
                                    <DataGridTextColumn Header="Date/Time Creation" Binding="{Binding CreatedAtLocal}" />
                                <DataGridTextColumn Header="Title" Binding="{Binding FeedbackTitle}" />


                            </DataGrid.Columns>

                        </DataGrid>
                            <Button Style="{StaticResource MyButtonStyle}" Grid.Column="1" Content="R" Click="RefreshMyFeedbacks" Margin="0,10"/>
                        </Grid>
                                <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,20,0">

                            <Button Click="Deletefeedback" Style="{StaticResource MyButtonStyle}" Content="Delete"/>

                        </StackPanel>
                    </Grid>
                    <Grid Margin="20,30,20,20" Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,10,0">

                                <TextBlock Style="{StaticResource MyTextBlockStyle}"  Text="Description" FontWeight="ExtraBold"  Margin="0,0,0,5"/>

                                <TextBox x:Name="descriptiontextbox" Style="{StaticResource MyTextBoxStyle}" IsReadOnly="True" FontWeight="Medium" FontSize="13" Margin="0,0,0,20"/>


                                <TextBlock Style="{StaticResource MyTextBlockStyle}"  Text="Feedback Answer"  FontWeight="ExtraBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="Answertextbox" Style="{StaticResource MyTextBoxStyle}" IsReadOnly="True" FontWeight="Medium" FontSize="13" Margin="0,0,0,20"/>

                                <TextBlock Style="{StaticResource MyTextBlockStyle}"  Text="Answer Date/Time"  FontWeight="ExtraBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="AnswerDateTimetextbox" Style="{StaticResource MyTextBoxStyle}" IsReadOnly="True" FontWeight="Medium" FontSize="13" Margin="0,0,0,20"/>

                                <TextBlock Style="{StaticResource MyTextBlockStyle}"  Text="Respondent"  FontWeight="ExtraBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="Respondenttextbox" Style="{StaticResource MyTextBoxStyle}" IsReadOnly="True" FontWeight="Medium" FontSize="13" Margin="0,0,0,20"/>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                                    <Button x:Name="ClearButton" Style="{StaticResource MyButtonStyle}" IsEnabled="False" Content="Clear" HorizontalAlignment="Center" Margin="0,0,15,0" Click="Button_Click_1" />

                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            
           

        </mah:MetroAnimatedTabControl>
    </Border>
</base:BaseUserControlMain>
