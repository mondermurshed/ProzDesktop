<base:BaseUserControlMain x:Class="Proz_DesktopApplication.Sub_Sub_Usercontrols.EmployeesLeaveRequestsHRManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:base="clr-namespace:Proz_DesktopApplication"
                           xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
               xmlns:sub_subUsercontrols ="clr-namespace:Proz_DesktopApplication.Sub_Sub_Sub_Usercontrols"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Proz_DesktopApplication.Sub_Sub_Usercontrols"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Margin="20,30,20,10">
        <mah:MetroAnimatedTabControl mah:HeaderedControlHelper.HeaderFontFamily="Microsoft YaHei UI" mah:TabControlHelper.Underlined="SelectedTabItem" mah:TabControlHelper.UnderlinePlacement="Left">
            <!-- TAB 1 -->
            <TabItem Header="Manage Employees Leave Requests">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="250" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter bar -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                       
                        <Button Content="Get" Style="{StaticResource MyButtonStyle}" Width="80" Click="GetLeaveRequests"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid x:Name="HRLeaveRequestsDataGrid"
                Grid.Row="1"
                AutoGenerateColumns="False"
                AlternationCount="1000000"
                IsReadOnly="True"
                SelectionMode="Single"
                SelectionChanged="HRLeaveRequestsDataGrid_SelectionChanged"
                FocusVisualStyle="{x:Null}">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="#" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}, Path=AlternationIndex}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Employee Name" Binding="{Binding employeeName}" />
                            <DataGridTextColumn Header="From" Binding="{Binding From}" />
                            <DataGridTextColumn Header="To" Binding="{Binding To}" />
                            <DataGridTextColumn Header="Request Old" Binding="{Binding CreatedAtAtLocal}" />
                            <DataGridTextColumn Header="Manager Name" Binding="{Binding DMName}" />
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- HR Message and Action Buttons -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,10,10">
                            <TextBlock Text="Reason Message:" Style="{StaticResource MyTextBlockStyle}" Margin="0,0,0,5"/>
                            <TextBox x:Name="EmployeeReasonTextbox" Style="{StaticResource MyTextBoxStyle}" IsReadOnly="True" FontWeight="Medium" FontSize="13" Margin="0,0,0,20"/>

                            <TextBlock Text="HR Final Message:" Style="{StaticResource MyTextBlockStyle}" Margin="0,0,0,5"/>
                            <TextBox x:Name="HRMessageTextbox" 
                       Style="{StaticResource MyTextBoxStyle}" 
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto"
                       Margin="0,0,0,20"/>
                            <CheckBox Content="Needed Approval" IsChecked="False" x:Name="NeedesApprovalCheckbox"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Approve" Style="{StaticResource MyButtonStyle}" Width="120" Click="ApproveButton_Click"/>
                                <Button Content="Reject" Style="{StaticResource MyButtonStyle}" Width="120" Margin="10,0,0,0" Click="RejectButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 2 -->
            <TabItem Header="Completed Leave Requests">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="250"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Row -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="20,10,20,10">
                
                        <Button Content="Get" Style="{StaticResource MyButtonStyle}" Width="80" Click="GetCompletedLeaveRequests"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid x:Name="CompletedRequestsDataGrid"
                Grid.Row="1"
                Margin="20,0,20,10"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                AlternationCount="1000000"
                SelectionMode="Single"
                SelectionChanged="CompletedRequestsDataGrid_SelectionChanged"
                FocusVisualStyle="{x:Null}">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="#" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}, Path=AlternationIndex}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Employee Name" Binding="{Binding employeeName}" />
                            <DataGridTextColumn Header="From" Binding="{Binding From}" />
                            <DataGridTextColumn Header="To" Binding="{Binding To}" />
                            <DataGridTextColumn Header="Request Old" Binding="{Binding LeaveRequestOLDAtLocal}" />
                            <DataGridTextColumn Header="Manager Name" Binding="{Binding ManagerName}" />
                            <DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" />
                            <DataGridTextColumn Header="Answer Old" Binding="{Binding AnswerOldInLocal}" />
                            <DataGridTextColumn Header="Is Approval Required?" Binding="{Binding AgreementNeeded}" />
                            <DataGridTextColumn Header="Agreed On ?" Binding="{Binding Agreed}" />
                            <DataGridTextColumn Header="Final Decision" Binding="{Binding Result}" />
                            <DataGridTextColumn Header="Decision Was Taking At" Binding="{Binding DecisionOldInLocal}" />

                         

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Details Section -->
                    <Grid Grid.Row="2" Margin="20,0,20,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,10,10,10">
                                <TextBlock Text="Reason" Style="{StaticResource MyTextBlockStyle}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="ReasonTextbox" 
                           Style="{StaticResource MyTextBoxStyle}" 
                           IsReadOnly="True" 
                           FontSize="13" 
                           Margin="0,0,0,20"/>

                                

                                <TextBlock Text="My Answer" Style="{StaticResource MyTextBlockStyle}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="HRFinalMessageTextbox" 
                           Style="{StaticResource MyTextBoxStyle}" 
                           IsReadOnly="True" 
                           FontSize="13" 
                           Margin="0,0,0,20"/>
                               
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>



        </mah:MetroAnimatedTabControl>
    </Border>
</base:BaseUserControlMain>
