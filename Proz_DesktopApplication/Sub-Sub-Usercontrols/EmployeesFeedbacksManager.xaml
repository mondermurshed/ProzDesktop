<base:BaseUserControlMain x:Class="Proz_DesktopApplication.Sub_Sub_Usercontrols.EmployeesFeedbacksManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                xmlns:base="clr-namespace:Proz_DesktopApplication"
             xmlns:sub_subUsercontrols ="clr-namespace:Proz_DesktopApplication.Sub_Sub_Sub_Usercontrols"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Proz_DesktopApplication.Sub_Sub_Usercontrols"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" GotFocus="UserControl_GotFocus">
    <Border Margin="20,30,20,10">
        <mah:MetroAnimatedTabControl mah:HeaderedControlHelper.HeaderFontFamily="Microsoft YaHei UI" mah:TabControlHelper.Underlined="SelectedTabItem" mah:TabControlHelper.UnderlinePlacement="Left">
            <!-- TAB 1 -->
            <TabItem Header="Manage My Employees Feedbacks Requests">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="250"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Section -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Sub-Department:" Style="{StaticResource MyTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="SubDepartmentComboBox" Width="200" Margin="0,0,10,0"/>
                        <Button Content="Get" Style="{StaticResource MyButtonStyle}" Width="80" Click="GetFeedbacks"/>
                    </StackPanel>

                    <!-- DataGrid Section -->
                    <DataGrid x:Name="FeedbackRequestsDataGrid"
              Grid.Row="1"
              AutoGenerateColumns="False"
              AlternationCount="1000000"
              IsReadOnly="True"
              SelectionMode="Single"
              SelectionChanged="Feedback_SelectionChanged"
              FocusVisualStyle="{x:Null}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="#" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}, Path=AlternationIndex}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Employee Name" Binding="{Binding RequesterEmployeeName}" />
                            <DataGridTextColumn Header="Type" Binding="{Binding FeedbackTypeName}" />
                            <DataGridTextColumn Header="Date/Time" Binding="{Binding CreatedAtLocal}" />
                            <DataGridTextColumn Header="Title" Binding="{Binding FeedbackTitle}" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Message & Action Section -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,10,10">
                            <TextBlock Text="Description:" Style="{StaticResource MyTextBlockStyle}" Margin="0,0,0,5"/>
                            <TextBox x:Name="DescriptionTextbox" Style="{StaticResource MyTextBoxStyle}" IsReadOnly="True" FontWeight="Medium" FontSize="13" Margin="0,0,0,20"/>

                            <TextBlock Text="Answer:" Style="{StaticResource MyTextBlockStyle}" Margin="0,0,0,5"/>
                            <TextBox x:Name="AnswerTextbox" Style="{StaticResource MyTextBoxStyle}"  TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20" MaxLength="1500"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Submit Answer" Style="{StaticResource MyButtonStyle}" Width="150" Click="SubmitAnswerButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 2 -->
            <TabItem Header="Completed Feedbacks Requests">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="250"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Sub-Department:" 
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="0,0,10,0"/>
                        <ComboBox x:Name="SubDepartmentComboBoxtab2" Width="200" Margin="0,0,10,0"/>
                        <Button Content="Get" Width="80" Click="GetFinishedFeedbacks"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid x:Name="AnsweredFeedbacksDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  AlternationCount="1000000"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="AnsweredFeedbacksDataGrid_SelectionChanged"
                  FocusVisualStyle="{x:Null}">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="#" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}, Path=AlternationIndex}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Employee Name" Binding="{Binding RequesterEmployeeName}" />
                            <DataGridTextColumn Header="Type" Binding="{Binding FeedbackTypeName}" />
                            <DataGridTextColumn Header="Date/Time" Binding="{Binding CreatedAtLocal}" />
                            <DataGridTextColumn Header="Title" Binding="{Binding FeedbackTitle}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Details -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,10,10">
                            <TextBlock Text="Description:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="DescriptionTextboxtab2" IsReadOnly="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,20"/>

                            <TextBlock Text="Answer:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="AnswerTextboxtab2" IsReadOnly="True" TextWrapping="Wrap" Height="80" Margin="0,0,0,20"/>

                            <TextBlock Text="Answered At:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="AnswerDateTextboxtab2" IsReadOnly="True" Margin="0,0,0,20"/>

                          
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>



        </mah:MetroAnimatedTabControl>
    </Border>
</base:BaseUserControlMain>
